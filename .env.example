# Banco de dados (Neon Postgres)
DATABASE_URL="postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Login do app (uso pessoal — escolha uma senha forte e um segredo aleatório longo)
APP_PASSWORD="troque-por-uma-senha-forte"
AUTH_SECRET="gere-com-openssl-rand-hex-32"

# Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY="AIza..."
# Opcional: modelo do Gemini (padrão: gemini-2.5-flash)
# GEMINI_MODEL="gemini-2.5-flash"

# Telegram (@BotFather -> /newbot)
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
TELEGRAM_BOT_USERNAME="seu_bot"
# Segredo qualquer (apenas letras, números, _ e -) que o Telegram envia no header do webhook
TELEGRAM_WEBHOOK_SECRET="um_segredo_longo_qualquer"
# Seu chat_id no Telegram. Se deixar vazio na 1ª vez e mandar "oi" para o bot, ele responde qual é o seu chat_id.
TELEGRAM_ALLOWED_CHAT_ID=""

# URL pública do seu app na Vercel (usada pelo botão "Ver no app" e pelo npm run setup)
APP_URL="https://seu-app.vercel.app"

# Opcional: desligar os comentários bem-humorados do mini-agente "Pão-duro" (on | off)
# AGENT_PAO_DURO="on"
